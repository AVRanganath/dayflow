{
  "name": "dayflow",
  "version": "0.1.0",
  "private": true,
  "description": "Dayflow HRMS — every workday, perfectly aligned.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "npm run db:generate --workspace @dayflow/db",
    "db:migrate": "npm run db:migrate --workspace @dayflow/db",
    "db:seed": "npm run db:seed --workspace @dayflow/db",
    "db:studio": "npm run db:studio --workspace @dayflow/db",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "turbo": "^2.1.2",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.5.0"
  }
}
