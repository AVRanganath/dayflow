# apps/api — copy to apps/api/.env for local development.
# Defaults match docker-compose.yml (postgres + redis on localhost).

PORT=8000
NODE_ENV=development

# Database (Prisma / Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dayflow?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth (JWT). Generate strong secrets for anything non-local.
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# CORS — the web origin allowed to call the API.
CORS_ORIGIN="http://localhost:3000"

# Email delivery provider (ADR-003). `console` logs the message instead of sending.
EMAIL_PROVIDER="console"
