# Dayflow — root example env. Copy per-app values into apps/api/.env and
# apps/web/.env.local (see those .example files). This root file documents the
# full set and provides defaults that match docker-compose.yml.

# --- Database (Prisma / Postgres) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dayflow?schema=public"

# --- Redis (cache, rate limiting, pub/sub) ---
REDIS_URL="redis://localhost:6379"

# --- API ---
PORT=8000
NODE_ENV=development
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"
CORS_ORIGIN="http://localhost:3000"

# --- Web ---
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
